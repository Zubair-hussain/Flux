# Flux settings. Copy this file to `.env.local` for local work (it is git-ignored).
# NEVER commit real values. On Render and Cloudflare, enter secrets in their dashboards.
# A value marked [SECRET] must never go in a NEXT_PUBLIC_* variable or into GitHub.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Local app and CLI (your own computer)
# ─────────────────────────────────────────────────────────────────────────────
# Optional paths if yt-dlp / Python / FFmpeg are not on PATH.
# YTDLP_PATH=C:/tools/yt-dlp.exe
# PYTHON_PATH=python
# FFMPEG_PATH=ffmpeg
# FLUX_API_URL=http://127.0.0.1:3000
# Delete finished downloads after this many days (0 keeps everything).
FLUX_RETENTION_DAYS=7

# ─────────────────────────────────────────────────────────────────────────────
# 2. Website (Cloudflare Worker) — set as GitHub Actions *variables* for the build,
#    and the [SECRET] ones in Cloudflare → Worker → Settings → Variables and Secrets.
# ─────────────────────────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000
# Keep false until your own domain is attached and the policy pages are final.
SEO_INDEXABLE=false
# Website that sends downloads to the backends (the load balancer).
FLUX_PUBLIC_SITE=true
FLUX_ROUTER=false
# [SECRET] Backend IDs to HTTPS addresses (no port, no path). A backend can be
# marked {"url": "...", "fallback": true} to be asked only after the others fail.
# FLUX_BACKENDS={"backend-1":"https://flux-backend.onrender.com","home-1":{"url":"https://home.example.com","fallback":true}}
FLUX_BACKENDS=
# Bot check, public half (build time). The secret half goes on the backends.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Only if one backend serves the site directly instead of using the router.
NEXT_PUBLIC_FLUX_API=

# ─────────────────────────────────────────────────────────────────────────────
# 3. Shared by the website router and EVERY backend
# ─────────────────────────────────────────────────────────────────────────────
# Realtime Database address, exactly as Firebase shows it.
FIREBASE_DATABASE_URL=
# [SECRET] Whole service-account JSON on one line (keep the escaped \n characters).
FIREBASE_SERVICE_ACCOUNT_JSON=
# [SECRET] One long random value, identical everywhere. Create it with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
FLUX_ROUTER_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 4. Each download backend (Render, or a home computer)
# ─────────────────────────────────────────────────────────────────────────────
FLUX_HOSTED=false
# Unique and stable; must match its key in FLUX_BACKENDS (backend-1, home-1, ...).
FLUX_BACKEND_ID=backend-1
# Websites allowed to call a backend directly from a browser (comma-separated).
FLUX_ALLOWED_ORIGINS=
# [SECRET] Bot-check secret; setting it turns the check on for this backend.
TURNSTILE_SECRET_KEY=
# Limits (the Render blueprint uses these small free-plan values).
FLUX_MAX_HEIGHT=720
FLUX_MAX_DURATION=300
FLUX_MAX_FILESIZE=100M
FLUX_MAX_CONCURRENT=1
FLUX_RETENTION_HOURS=1
# Per visitor: lookups per 10 minutes and downloads per hour (0 turns a limit off).
FLUX_RATE_INSPECT=30
FLUX_RATE_DOWNLOAD=8
# Optional proxy for platforms that refuse data-centre addresses.
# [SECRET] if it contains a username and password.
# FLUX_PROXY_URL=http://user:pass@proxy.example:8080
# FLUX_PROXY_PLATFORMS=youtube,dailymotion

# ─────────────────────────────────────────────────────────────────────────────
# 5. Optional extras
# ─────────────────────────────────────────────────────────────────────────────
# Blog posts from Google Blogger.
BLOGGER_BLOG_ID=
BLOGGER_API_KEY=
# Google AdSense (not Google Ads campaigns). Ads stay off unless all three are set.
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false
# Set only AFTER consent management is configured. This is a deployment
# acknowledgement, NOT a visitor consent mechanism.
ADSENSE_CONSENT_READY=false
# Optional 10-digit ad-unit IDs (AdSense → Ads → By ad unit).
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_CONTENT=
# Show empty "Ad space reserved" boxes to review layout (no Google request).
ADSENSE_PREVIEW=false
