# Optional absolute path to yt-dlp executable. Default: python -m yt_dlp
# YTDLP_PATH=C:/tools/yt-dlp.exe
# PYTHON_PATH=python
# FLUX_API_URL=http://127.0.0.1:3000

# Public launch configuration: keep indexing disabled until placeholders are replaced.
SITE_URL=http://localhost:3000
SEO_INDEXABLE=false
BLOGGER_BLOG_ID=
BLOGGER_API_KEY=

# Optional Google AdSense Auto ads (not Google Ads campaign/conversion tracking).
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false
# Set only AFTER configuring required consent management and updating policies.
# This flag is a deployment acknowledgement, NOT a visitor consent mechanism.
ADSENSE_CONSENT_READY=false
# Optional manual ad units (10-digit IDs from AdSense → Ads → By ad unit).
# Without them, only Auto ads run. Slots sit below the download tools, never next to buttons.
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_CONTENT=
# Show empty, labelled "Ad space reserved" boxes to review layout before approval.
# Makes no Google request. Turn off for the public launch.
ADSENSE_PREVIEW=false
