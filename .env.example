# Optional absolute path to yt-dlp executable. Default: python -m yt_dlp
# YTDLP_PATH=C:/tools/yt-dlp.exe
# PYTHON_PATH=python
# FLUX_API_URL=http://127.0.0.1:3000

# Public launch configuration: keep indexing disabled until placeholders are replaced.
SITE_URL=http://localhost:3000
SEO_INDEXABLE=false
BLOGGER_BLOG_ID=
BLOGGER_API_KEY=

# Optional Google AdSense Auto ads (not Google Ads campaign/conversion tracking).
ADSENSE_CLIENT_ID=
ADSENSE_ENABLED=false
# Set only AFTER configuring required consent management and updating policies.
# This flag is a deployment acknowledgement, NOT a visitor consent mechanism.
ADSENSE_CONSENT_READY=false
# Optional manual ad units (10-digit IDs from AdSense → Ads → By ad unit).
# Without them, only Auto ads run. Slots sit below the download tools, never next to buttons.
ADSENSE_SLOT_HOME=
ADSENSE_SLOT_CONTENT=
# Show empty, labelled "Ad space reserved" boxes to review layout before approval.
# Makes no Google request. Turn off for the public launch.
ADSENSE_PREVIEW=false

# Delete finished downloads after this many days (0 keeps everything).
FLUX_RETENTION_DAYS=7

# Shared download directory (server secrets, NEVER NEXT_PUBLIC_*).
# Create a Realtime Database and paste its exact HTTPS URL here.
FIREBASE_DATABASE_URL=
# Entire service-account JSON as one line; keep the private key's escaped \n characters.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Stable, unique ID for each backend; must match its key in FLUX_BACKENDS.
FLUX_BACKEND_ID=backend-1
# Same long random value on router and all backends.
FLUX_ROUTER_SECRET=

# Website/router only. Also set FLUX_ROUTER=true during the website build.
FLUX_ROUTER=false
# JSON object of stable backend IDs to HTTPS origins (no path).
FLUX_BACKENDS=
# Example: {"backend-1":"https://flux-backend.onrender.com"}
# Hosted backend only (the Dockerfile sets this automatically).
FLUX_HOSTED=false
FLUX_ALLOWED_ORIGINS=
# Optional bot protection: public site key at build time; secret on backends only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
